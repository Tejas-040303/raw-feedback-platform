{
  "name": "raw-feedback-platform",
  "private": true,
  "workspaces": ["apps/*"],
  "scripts": {
    "db:up": "docker compose up -d postgres redis",
    "db:migrate": "for f in db/migrations/*.sql; do psql \"$DATABASE_URL\" -v ON_ERROR_STOP=1 -f \"$f\" || exit 1; done",
    "db:seed": "psql \"$DATABASE_URL\" -v ON_ERROR_STOP=1 -f db/seed.sql",
    "dev:api": "npm run dev -w apps/api",
    "dev:web": "npm run dev -w apps/web",
    "test": "npm test -w apps/api"
  }
}
