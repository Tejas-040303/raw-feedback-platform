DATABASE_URL=postgres://rfp:rfp@localhost:5432/rfp
PORT=4000
WEB_ORIGIN=http://localhost:3000
# Number of proxies in front of the API (0 locally; usually 1 behind a load balancer).
TRUST_PROXY=0
NEXT_PUBLIC_API_URL=http://localhost:4000

# Optional. Without it, moderation runs with the built-in rules only.
ANTHROPIC_API_KEY=
MODERATION_MODEL=claude-opus-5-5
