{
  "name": "@rfp/api",
  "private": true,
  "engines": {
    "node": ">=22.9"
  },
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=../../.env dist/main.js",
    "dev": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/dev.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --experimental-strip-types --disable-warning=ExperimentalWarning --test \"test/*.test.ts\"",
    "test:db": "node --experimental-strip-types --disable-warning=ExperimentalWarning --env-file-if-exists=../../.env --test \"test/db/*.test.ts\"",
    "db:migrate": "node --experimental-strip-types --disable-warning=ExperimentalWarning --env-file-if-exists=../../.env scripts/db.ts migrate",
    "db:seed": "node --experimental-strip-types --disable-warning=ExperimentalWarning --env-file-if-exists=../../.env scripts/db.ts seed"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "latest",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "pg": "^8.13.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "typescript": "^5.7.0"
  }
}
